# Local frontend — copy to .env.local and edit.
# See docs/development/team-onboarding.md

# Backend API (required)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth off by default for fast local iteration
NEXT_PUBLIC_AUTH_REQUIRED=false

# Firebase web client (optional until you test Google sign-in locally)
# Copy from Firebase Console → Project settings → Your apps → Web app
# Or ask your team lead for the same values used in GitHub Actions variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PostHog (optional — match GitHub vars or leave empty)
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false
